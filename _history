<shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></next></block></statement><next><block type=\"oledssd1306_write_string\"><value name=\"s\"><block type=\"variables_get\"><field name=\"VAR\" id=\"s@w3FR~tf2ZG^J`xQVlc\">Sch</field></block></value></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"\"\"\"\n\nDie Türme von Hanoi\n\nTaste A: Aktion wechseln\n\nTaste B: Aktion ausführen\n\nTaste A+B: Automatischer Ablauf (Lösung)\n\nNäheres bei Wikipedia oder demnächst bei \n\nhttps://www.prof-horst-guenther.de/calliope\n\n\"\"\"\ndef zeige_Kopf():\n    global von_Turm, nach_Turm, pos, txt\n    von_Turm = job_Aktion[job] / 10\n    von_Turm = Math.floor(von_Turm)\n    nach_Turm = job_Aktion[job] % 10\n    if job == 3 or job == 5:\n        pos = 5\n    else:\n        pos = 0\n    txt = job_Linie[job]\n    write_xy(1, pos, txt)\n    txt = \"\" + chr2(von_Turm) + \" nach \" + chr2(nach_Turm)\n    write_xy(7, 0, txt)\ndef write_xy(z: number, s: number, Text: str):\n    oledssd1306.set_text_xy(z, s)\n    oledssd1306.write_string(Text)\ndef lösche_Scheibe(Turm: List[number]):\n    global Scheibe, splt, zl\n    Scheibe = Turm[0]\n    splt = von_Turm * 5\n    zl = 6 - len(Turm)\n    oledssd1306.set_text_xy(zl, splt)\n    oledssd1306.clear_range(5)\ndef hanoi(n: number, start: number, ziel: number, hilf: number):\n    global von_Turm, nach_Turm, Scheibe\n    if n == 0:\n        return\n    hanoi(n - 1, start, hilf, ziel)\n    von_Turm = start\n    nach_Turm = ziel\n    holeTurm(start)\n    Scheibe = Turm3[0]\n    verschiebe()\n    basic.pause(800)\n    hanoi(n - 1, hilf, ziel, start)\ndef Turm_Namen():\n    write_xy(0, 0, \"A\")\n    write_xy(0, 5, \"B\")\n    write_xy(0, 10, \"C\")\ndef verschiebe():\n    global zug\n    if nach_Turm == 0:\n        einfügen_Scheibe(A)\n        A.unshift(Scheibe)\n    elif nach_Turm == 1:\n        einfügen_Scheibe(B)\n        B.unshift(Scheibe)\n    else:\n        einfügen_Scheibe(C)\n        C.unshift(Scheibe)\n    if von_Turm == 0:\n        lösche_Scheibe(A)\n        A.shift()\n    elif von_Turm == 1:\n        lösche_Scheibe(B)\n        B.shift()\n    else:\n        lösche_Scheibe(C)\n        C.shift()\n    zug += 1\ndef holeTurm(TNr2: number):\n    global Turm3\n    if TNr2 == 0:\n        Turm3 = A\n    elif TNr2 == 1:\n        Turm3 = B\n    else:\n        Turm3 = C\n\ndef on_button_a():\n    global Scheiben_Zahl, Start, job, von_Turm\n    if Start == 0:\n        Scheiben_Zahl = 3\n        Start = 1\n        oledssd1306.clear_display()\n        Turm_Namen()\n        zeige_Kopf()\n        Zeige_Turm_0()\n    else:\n        oledssd1306.set_text_xy(1, 0)\n        oledssd1306.clear_range(16)\n        oledssd1306.set_text_xy(7, 0)\n        oledssd1306.clear_range(16)\n        job += 1\n        job = job % 6\n        von_Turm = Jobs[job] / 10\n        von_Turm = Math.floor(von_Turm)\n        zeige_Kopf()\ninput.on_button_event(Button.A, input.button_event_click(), on_button_a)\n\ndef zeige_Scheibe(nr: number):\n    global Sch, j\n    Sch = \"\"\n    j = 0\n    while j <= prev(nr):\n        # Scheibe mit oderr ohne Nummer\n        if j == 0 and False:\n            Sch = \"\" + Sch + (\"\" + str(nr))\n        else:\n            Sch = \"\" + Sch + \"=\"\n        j += 1\n    oledssd1306.write_string(Sch)\n\ndef on_button_ab():\n    global zug\n    oledssd1306.clear_display()\n    zug = 0\n    Turm_Namen()\n    Zeige_Turm_0()\n    hanoi(Scheiben_Zahl, 0, 1, 2)\n    oledssd1306.set_text_xy(7, 0)\n    oledssd1306.write_string(\"Fertig \" + str(zug) + \" Züge\")\ninput.on_button_event(Button.AB, input.button_event_click(), on_button_ab)\n\ndef einfügen_Scheibe(Turm2: List[any]):\n    global splt, zl\n    splt = nach_Turm * 5\n    zl = 5 - len(Turm2)\n    oledssd1306.set_text_xy(zl, splt)\n    zeige_Scheibe(Scheibe)\n\ndef on_button_b():\n    global Scheiben_Zahl, Scheibe\n    if Start == 0:\n        A.append(4)\n        Scheiben_Zahl = 4\n        oledssd1306.clear_display()\n        Turm_Namen()\n        zeige_Kopf()\n        Zeige_Turm_0()\n    else:\n        holeTurm(von_Turm)\n        if len(Turm3) == 0:\n            music.play(music.tone_playable(60, music.beat(BeatFraction.DOUBLE)),\n                music.PlaybackMode.UNTIL_DONE)\n            write_xy(7, 0, \"Turm ist leer\")\n        else:\n            Scheibe = Turm3[0]\n            holeTurm(nach_Turm)\n            if Scheibe > Turm3[0]:\n                music.play(music.tone_playable(60, music.beat(BeatFraction.DOUBLE)),\n                    music.PlaybackMode.UNTIL_DONE)\n                write_xy(7, 0, \"Scheibe größer\")\n            else:\n                verschiebe()\n                if len(B) == Scheiben_Zahl or len(C) == Scheiben_Zahl:\n                    oledssd1306.set_text_xy(7, 0)\n                    oledssd1306.write_string(\"Fertig \" + str(zug) + \" Züge\")\n                    basic.set_led_colors(0x00ff00, 0x00ff00, 0x00ff00)\ninput.on_button_event(Button.B, input.button_event_click(), on_button_b)\n\ndef Begrüßung():\n    write_xy(0, 0, \"Türme von Hanoi\")\n    write_xy(1, 0, \"Taste A:\")\n    write_xy(2, 3, \"Aktion wählen\")\n    write_xy(3, 0, \"Taste B:\")\n    write_xy(4, 3, \"Aktion ausf.\")\n    write_xy(5, 0, \"Taste A+B:\")\n    write_xy(6, 3, \"Automatik\")\n    write_xy(7, 0, \"Bitte warten\")\n    basic.pause(5000)\n    oledssd1306.clear_display()\ndef Zeige_Turm_0():\n    Index = 0\n    while Index <= prev(Scheiben_Zahl):\n        oledssd1306.set_text_xy(Index + (6 - Scheiben_Zahl), 0)\n        zeige_Scheibe(Index + 1)\n        Index += 1\ndef chr2(w: number):\n    return String.from_char_code(w + 65)\ndef prev(anz: number):\n    global tmp\n    tmp = anz - 1\n    return tmp\ndef Scheibenzahl():\n    global Start\n    write_xy(0, 0, \"Anzahl Scheiben\")\n    write_xy(2, 4, \"Taste A: 3\")\n    write_xy(4, 4, \"Taste B: 4\")\n    Start = 0\ntmp = 0\nj = 0\nSch = \"\"\nStart = 0\nzug = 0\nTurm3: List[number] = []\nzl = 0\nsplt = 0\nScheibe = 0\ntxt = \"\"\npos = 0\nnach_Turm = 0\njob_Linie: List[str] = []\njob_Aktion: List[number] = []\njob = 0\nJobs: List[number] = []\nC: List[number] = []\nB: List[number] = []\nScheiben_Zahl = 0\nA: List[number] = []\nvon_Turm = 0\noledssd1306.init_display()\noledssd1306.clear_display()\nvon_Turm = 0\nA = [1, 2, 3]\nScheiben_Zahl = len(A)\nB = [0]\nB.shift()\nC = [0]\nC.shift()\nJobs = [1, 2, 10, 12, 20, 21]\njob = 0\njob_Aktion = [1, 2, 10, 12, 20, 21]\njob_Linie = [\"+>-->+\",\n    \"+>------->+\",\n    \"+<--<+\",\n    \"+>-->+\",\n    \"+<-------<+\",\n    \"+<--<+\"]\nvon_Turm = 0\nnach_Turm = 1\nBegrüßung()\nScheibenzahl()","pxt.json":"{\n    \"name\": \"Tuerme_von_Hanoi\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"v3\": \"*\",\n        \"pxt-oled-ssd1306\": \"github:mkleinsb/pxt-oled-ssd1306#v1.0.1\",\n        \"warte bis...\": \"github:calliope-edu/warte-bis#f771255087368c53690ea55c66da295e41c4d0c3\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"master\",\n        \"tag\": \"v8.1.11\",\n        \"commits\": \"https://github.com/microsoft/pxt-calliope/commits/41d6b631a7a67619a6119b755d3db06cab4d72f8\",\n        \"target\": \"8.1.11\",\n        \"pxt\": \"12.2.8\"\n    },\n    \"preferredEditor\": \"blocksprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794427423252}